+.log-kind.REIMAGE      { color: #3fb950; }
+.log-kind.BLOCK        { color: #d29922; }
+.log-kind.ALLOW        { color: #79c0ff; }
+.log-kind.STOP_SVC     { color: #e3a04a; }
+.log-kind.START_SVC    { color: #79c0ff; }
