+        if defender_file and defender_frozen:
+            defender_builder = FrozenAgentBuilder(
+                alg_type=algo_map[defender_algo], file_path=defender_file
+            )
+        elif defender_file:
+            defender_builder = LoadFileBaselineAgentBuilder(
+                alg_type=algo_map[defender_algo], file_path=defender_file
+            )
+        else:
