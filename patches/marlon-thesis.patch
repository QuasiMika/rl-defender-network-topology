+            CROWN_JEWEL_NODE in entry.get("owned", [])
+            for entry in attacker_log
+        )
+    return {
+        "steps_taken":  steps_taken,
+        "max_steps":    timesteps,
+        "att_score":    round(float(att_score), 1),
+        "def_score":    round(float(def_score), 1),
+        "events":       events,
+        "early_stop":   early_stop,
+        "goal_reached": goal_reached,
