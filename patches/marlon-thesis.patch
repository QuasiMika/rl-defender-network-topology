+<script src='https://cdn.plot.ly/plotly-latest.min.js'></script>
+<script>
+// ── Train tab: zeige Einfrieren/Finetuning-Option wenn Datei gewählt ──
+function showModeOptions(role, input) {
+    var box = document.getElementById(role + 'ModeBox');
+    box.style.display = input.files.length > 0 ? 'block' : 'none';
+}
+
+// ── Graph navigation ──────────────────────────────────────────────────
+var num_graphs  = {{num_graphs | safe}};
+var graphs      = {{graphs | safe}};
+var index       = 0;
+var graphSelect = 0;
+var defenderView = false;
+
+var spnProgress = document.getElementById("spnProgress");
+var spnScore    = document.getElementById("spnScore");
+var btnNext     = document.getElementById("btnNext");
+var btnPrev     = document.getElementById("btnPrevious");
+var btnView     = document.getElementById("btnView");
+
+async function renderGraph(i) {
+    Plotly.newPlot('chart', graphs[i][graphSelect], {});
+    spnProgress.textContent = graphs[i][2] + '/' + graphs[num_graphs-1][2];
+    return defenderView ? graphs[i][4] : graphs[i][3];
+}
+async function updateGraph() {
+    var score = await renderGraph(index);
+    spnScore.textContent = score;
+    btnNext.disabled = (index == num_graphs - 1);
+    btnPrev.disabled = (index == 0);
+}
+btnNext.onclick = async () => { ++index; await updateGraph(); };
+btnPrev.onclick = async () => { --index; await updateGraph(); };
+btnView.onclick = async () => {
+    defenderView = !defenderView;
+    btnView.innerHTML = defenderView ? 'Attacker View' : 'Defender View';
+    btnView.className = defenderView ? 'attacker' : 'defender';
+    graphSelect = defenderView ? 1 : 0;
+    await updateGraph();
+    filterLog();   // Log-Panel zur neuen Ansicht wechseln
+};
+if (num_graphs === 0) {
+    btnNext.disabled = true; btnPrev.disabled = true; btnView.disabled = true;
+} else {
+    updateGraph();
+}
+
+// ── Tabs ──────────────────────────────────────────────────────────────
+function openTab(evt, name) {
+    document.querySelectorAll('.tabcontent').forEach(t => t.style.display = 'none');
+    document.querySelectorAll('.tablinks').forEach(b => b.className = b.className.replace(' active',''));
+    document.getElementById(name).style.display = 'block';
+    evt.currentTarget.className += ' active';
+}
+document.querySelector('.tablinks').click();
+
+function yesnoCheck(agent) {
+    var atk = document.getElementById('ifYesAttacker');
+    var def = document.getElementById('ifYesDefender');
+    if      (agent === 'attacker')   atk.style.visibility = 'visible';
+    else if (agent === 'defender')   def.style.visibility = 'visible';
+    else if (agent === 'noAttacker') atk.style.visibility = 'hidden';
+    else if (agent === 'noDefender') def.style.visibility = 'hidden';
+}
+
+// ── Action log ────────────────────────────────────────────────────────
+var attackerLogData = {{ attacker_log | tojson }};
+var defenderLogData = {{ defender_log | tojson }};
+
+function filterLog() {
+    var list = document.getElementById('logList');
+    if (!list) return;
+
+    var show;
+    if (!defenderView) {
+        show = {
+            LATERAL_MOVE: document.getElementById('chkLateral')  ?.checked ?? true,
+            CREDS_FOUND:  document.getElementById('chkCreds')    ?.checked ?? true,
+            DISCOVERY:    document.getElementById('chkDiscovery')?.checked ?? true,
+            REWARD:       document.getElementById('chkReward')   ?.checked ?? true,
+            FAILED:       document.getElementById('chkFailed')   ?.checked ?? false,
+        };
+    } else {
+        show = {
+            REIMAGE:   document.getElementById('chkReimage')  ?.checked ?? true,
+            BLOCK:     document.getElementById('chkBlock')    ?.checked ?? true,
+            ALLOW:     document.getElementById('chkAllow')    ?.checked ?? true,
