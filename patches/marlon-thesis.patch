@@ -0,0 +1,110 @@
+"""
+Defender Training — alle Test-Topologien
+=========================================
+Nutzt einen einzigen eingefrorenen Super-Attacker als Gegner
+und trainiert für jede Test-Topologie einen frischen Defender (BA).
+
+Verwendung:
+    python train_defenders.py --attacker models/super_attacker_final_XYZ.zip
+
+    # Einzelne Topologie:
+    python train_defenders.py --attacker models/super_attacker_final_XYZ.zip --only flat
+"""
+
+import argparse
+import os
+import sys
+
+MARLON_PATH  = os.path.dirname(os.path.abspath(__file__))
+PROJECT_ROOT = os.path.dirname(MARLON_PATH)
+sys.path.insert(0, PROJECT_ROOT)
+sys.path.insert(0, MARLON_PATH)
+
+from thesis_topology.envs import register_all
+register_all()
+
+from marlon.simulate import train
+
+TEST_TOPOLOGIES = {
+    "flat":         "CyberBattleFlat-thesis-v0",
+    "hub_and_spoke":"CyberBattleHubSpoke-thesis-v0",
+    "dmz":          "CyberBattleDMZ-thesis-v0",
+    "micro_seg":    "CyberBattleMicroSeg-thesis-v0",
+}
+
+DEFAULT_STEPS         = 200_000
+DEFAULT_EPISODE_STEPS = 2_000
+SAVE_DIR = os.path.join(MARLON_PATH, "models")
+
+
+def run_defender_training(
+    attacker_path: str,
+    topology_subset: list[str] | None = None,
+    steps: int = DEFAULT_STEPS,
+    episode_steps: int = DEFAULT_EPISODE_STEPS,
+    save_dir: str = SAVE_DIR,
+) -> dict[str, str]:
+    """
+    Trainiert einen Defender pro Test-Topologie.
+    Der Attacker ist eingefroren (kein weiteres Training).
+
+    Returns
+    -------
+    Dict {topology_name: defender_model_path}
+    """
+    topos = {k: v for k, v in TEST_TOPOLOGIES.items()
+             if topology_subset is None or k in topology_subset}
+
+    print(f"\n{'='*60}")
+    print(f"  Defender Training ({len(topos)} Topologien)")
+    print(f"  Attacker (frozen): {os.path.basename(attacker_path)}")
+    print(f"  Steps/Topo       : {steps:,}")
+    print(f"{'='*60}\n")
+
+    results = {}
+    for name, env_id in topos.items():
+        print(f"  [{name}] {env_id}")
+
+        result = train(
+            env_id=env_id,
+            attacker_algo="PPO",
+            defender_algo="PPO",
+            total_timesteps=steps,
+            episode_steps=episode_steps,
+            save_dir=save_dir,
+            attacker_file=attacker_path,
+            defender_file=None,          # BA startet frisch
+            attacker_frozen=True,        # RA eingefroren → kontrollierte Baseline
+            defender_frozen=False,
+        )
+        results[name] = result["defender"]
+        print(f"    → {os.path.basename(result['defender'])}\n")
+
+    print(f"{'='*60}")
+    print("  Alle Defender gespeichert:")
+    for name, path in results.items():
+        print(f"    {name:12s}  {os.path.basename(path)}")
+    print(f"{'='*60}\n")
+
+    return results
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Defender Training auf allen Test-Topologien")
+    parser.add_argument("--attacker",      required=True,
+                        help="Pfad zum Super-Attacker .zip (eingefroren)")
+    parser.add_argument("--steps",         type=int, default=DEFAULT_STEPS,
+                        help=f"Timesteps pro Topologie (default: {DEFAULT_STEPS})")
+    parser.add_argument("--episode-steps", type=int, default=DEFAULT_EPISODE_STEPS,
+                        help=f"Max Schritte pro Episode (default: {DEFAULT_EPISODE_STEPS})")
+    parser.add_argument("--only",          type=str, default=None,
+                        help="Nur eine Topologie, z.B. 'flat' oder 'dmz'")
+    args = parser.parse_args()
+
+    subset = [args.only] if args.only else None
+    run_defender_training(
+        attacker_path=args.attacker,
+        topology_subset=subset,
+        steps=args.steps,
+        episode_steps=args.episode_steps,
+    )
