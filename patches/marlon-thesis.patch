+    os.makedirs(save_dir, exist_ok=True)
+    # Mikrosekunden im Zeitstempel: sonst kollidieren run_ids paralleler Laeufe
+    # auf derselben Topologie (gleiche Sekunde) -> Aggregation verwirft Duplikate.
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S_%f")
+    env_short = env_id.replace("-", "_").replace(".", "_")
+
+    # Seed setzen (vor Modell-/Env-Erzeugung), damit Laeufe reproduzierbar und
+    # ueber verschiedene Seeds unterscheidbar sind.
+    if seed is not None:
