diff -ruN a/marlon/convergence.py b/marlon/convergence.py
--- a/marlon/convergence.py	1970-01-01 01:00:00.000000000 +0100
+++ b/marlon/convergence.py	2026-08-31 11:34:08.337610921 +0200
@@ -0,0 +1,169 @@
+"""
+Konvergenz-Erkennung für RL-Trainingsläufe (topologie-unabhängig).
+
+Definition (angelehnt an die übliche RL-Praxis: gleitendes Fenster über den
+Episoden-Reward, Konvergenz = geglätteter Mittelwert stagniert UND die
+kurzfristige Streuung fällt unter eine Toleranz; vgl. Reward-Smoothing /
+late-stage reward drop in der RL-Literatur):
+
+    Konvergenz bei der ersten Episode t, ab der über ein Fenster von W
+    Episoden gilt:
+      (1) STREUUNG:  std(reward_{t-W+1..t}) / span  <=  cv_threshold
+      (2) TREND:     |mean_t - mean_{t-W}| / span   <=  slope_threshold
+    und beide Bedingungen für P aufeinanderfolgende Episoden ("Patience")
+    gehalten werden, damit frühe Schein-Plateaus nicht auslösen.
+
+`span` ist die Reward-Spanne (max-min) des bisherigen Laufs. Die Normierung
+auf die Spanne statt auf den Mittelwert (klassischer CV = std/mean) ist
+bewusst gewählt: Der Defender-Reward pendelt um 0, ein CV würde dort durch
+Division durch ~0 explodieren. std/span ist über die Nulllinie stabil und
+überträgt sich fair zwischen Topologien mit sehr unterschiedlichem
+Reward-Niveau.
+
+Annahme: stationäres Ziel. Gilt für die Defender-Matrix (Angreifer
+eingefroren). NICHT für Self-Play (bewegtes Ziel) — dort darf der Auto-Stop
+nicht verwendet werden.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import List, Optional, Sequence
+
+import numpy as np
+
+
+# ── Standard-Parameter (empirisch an Lauf 20260722 kalibriert) ────────────────
+DEFAULT_WINDOW = 15          # Fenstergröße W (Prof-Vorgabe)
+DEFAULT_CV_THRESHOLD = 0.05  # std/span-Schwelle für "streuungsarm"
+DEFAULT_SLOPE_THRESHOLD = 0.05  # |Δmean|/span-Schwelle für "kein Trend"
+DEFAULT_PATIENCE = 10        # P: so viele Episoden muss das Kriterium halten
+DEFAULT_MIN_SPAN = 1.0       # numerischer Schutz gegen Division durch 0
+
+
+@dataclass
+class ConvergenceResult:
+    converged: bool
+    episode: Optional[int]        # 1-basierte Episode, ab der Konvergenz gilt (Ende der Patience)
+    detected_at: Optional[int]    # Episode, an der das Kriterium erstmals dauerhaft griff (Start der Patience)
+    window: int
+    cv_threshold: float
+    slope_threshold: float
+    patience: int
+
+
+def _span(rewards: np.ndarray) -> float:
+    if rewards.size == 0:
+        return DEFAULT_MIN_SPAN
+    return max(float(rewards.max() - rewards.min()), DEFAULT_MIN_SPAN)
+
+
+def convergence_signal(
+    rewards: Sequence[float],
+    window: int = DEFAULT_WINDOW,
+    cv_threshold: float = DEFAULT_CV_THRESHOLD,
+    slope_threshold: float = DEFAULT_SLOPE_THRESHOLD,
+) -> np.ndarray:
+    """Boolescher Vektor: erfüllt Episode t (0-basiert) Streuungs- UND Trendbedingung?
+
+    Für t < 2*window-1 ist das Ergebnis False (nicht genug Historie für den
+    Trendvergleich zweier aufeinanderfolgender Fenster).
+    """
+    r = np.asarray(rewards, dtype=float)
+    n = r.size
+    ok = np.zeros(n, dtype=bool)
+    if n < 2 * window:
+        return ok
+    span = _span(r)
+    for t in range(2 * window - 1, n):
+        cur = r[t - window + 1: t + 1]
+        prev = r[t - 2 * window + 1: t - window + 1]
+        std_ok = cur.std() / span <= cv_threshold
+        slope_ok = abs(cur.mean() - prev.mean()) / span <= slope_threshold
+        ok[t] = std_ok and slope_ok
+    return ok
+
+
+def detect_convergence(
+    rewards: Sequence[float],
+    window: int = DEFAULT_WINDOW,
+    cv_threshold: float = DEFAULT_CV_THRESHOLD,
+    slope_threshold: float = DEFAULT_SLOPE_THRESHOLD,
+    patience: int = DEFAULT_PATIENCE,
+) -> ConvergenceResult:
+    """Ermittelt die Konvergenz-Episode für eine komplette Reward-Sequenz.
+
+    Konvergenz wird erklärt, sobald das Fensterkriterium `patience` Episoden
+    ununterbrochen erfüllt ist. Zurückgegeben wird die Episode am ENDE dieser
+    Patience-Strecke (1-basiert) — ab da gilt der Lauf als konvergiert.
+    """
+    ok = convergence_signal(rewards, window, cv_threshold, slope_threshold)
+    run = 0
+    for t in range(ok.size):
+        if ok[t]:
+            run += 1
+            if run >= patience:
+                return ConvergenceResult(
+                    converged=True,
+                    episode=t + 1,
+                    detected_at=t - patience + 2,
+                    window=window, cv_threshold=cv_threshold,
+                    slope_threshold=slope_threshold, patience=patience,
+                )
+        else:
+            run = 0
+    return ConvergenceResult(
+        converged=False, episode=None, detected_at=None,
+        window=window, cv_threshold=cv_threshold,
+        slope_threshold=slope_threshold, patience=patience,
+    )
+
+
+class ConvergenceMonitor:
+    """Inkrementeller Online-Detektor für die Trainingsschleife.
+
+    Nach jeder abgeschlossenen Episode `update(reward)` aufrufen. `converged`
+    wird True, sobald das Fensterkriterium `patience` Episoden in Folge hält.
+    Die Reward-Spanne wächst dabei mit dem beobachteten Verlauf mit.
+    """
+
+    def __init__(
+        self,
+        window: int = DEFAULT_WINDOW,
+        cv_threshold: float = DEFAULT_CV_THRESHOLD,
+        slope_threshold: float = DEFAULT_SLOPE_THRESHOLD,
+        patience: int = DEFAULT_PATIENCE,
+        min_episodes: int = 0,
+    ):
+        self.window = window
+        self.cv_threshold = cv_threshold
+        self.slope_threshold = slope_threshold
+        self.patience = patience
+        self.min_episodes = min_episodes
+        self._rewards: List[float] = []
+        self._run = 0
+        self.converged = False
+        self.converged_episode: Optional[int] = None
+
+    def update(self, episode_reward: float) -> bool:
+        """Fügt eine Episode hinzu und gibt zurück, ob JETZT Konvergenz gilt."""
+        self._rewards.append(float(episode_reward))
+        n = len(self._rewards)
+        if self.converged:
+            return True
+        if n < 2 * self.window or n < self.min_episodes:
+            return False
+        r = np.asarray(self._rewards, dtype=float)
+        span = _span(r)
+        cur = r[-self.window:]
+        prev = r[-2 * self.window:-self.window]
+        std_ok = cur.std() / span <= self.cv_threshold
+        slope_ok = abs(cur.mean() - prev.mean()) / span <= self.slope_threshold
+        if std_ok and slope_ok:
+            self._run += 1
+            if self._run >= self.patience:
+                self.converged = True
+                self.converged_episode = n
+                return True
+        else:
+            self._run = 0
+        return False
