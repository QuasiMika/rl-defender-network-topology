+def _compute_stats(simulation, timesteps, env_id, attacker_log=None):
+    if not simulation:
+        return {}
+    last = simulation[-1]
+    steps_taken  = last[2]
+    att_score    = last[3]
+    def_score    = last[4]
+    events       = len(simulation) - 1
+    early_stop   = steps_taken < timesteps
+    # Crown Jewel: prüfe ob DatabaseServer tatsächlich im Attacker-Log als owned auftaucht.
