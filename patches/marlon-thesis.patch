--- a/train_super_attacker.py	1970-01-01 01:00:00.000000000 +0100
+++ b/train_super_attacker.py	2026-08-31 11:34:08.341644311 +0200
@@ -0,0 +1,147 @@
+"""
+Sequenzielles Super-Attacker Training
+======================================
+Trainiert EINEN Attacker-Agenten nacheinander auf mehreren Topologien.
+Jede Stufe lädt das Modell der vorherigen Stufe → Transfer Learning.
+Ergebnis: ein einziges "Super-Modell", das alle Topologien gesehen hat.
+
+Verwendung:
+    python train_super_attacker.py
+
+    # Oder mit eigenen Parametern:
+    python train_super_attacker.py --steps 50000 --episode-steps 2000
+
+Thesis-Workflow:
+    Phase 1 – Super-Attacker Pretraining (dieser Script)
+        Chain → Flat → HubSpoke → DMZ → MicroSeg
+        Ergebnis: models/super_attacker_final.zip
+
+    Phase 2 – Defender Training (pro Topologie, via Web-UI oder defend_runs.py)
+        Super-Attacker EINFRIEREN, BA frisch trainieren
+        → 4 Defender-Modelle (eines pro Test-Topologie)
+"""
+
+import argparse
+import os
+import sys
+from datetime import datetime
+
+# Skript liegt in MARLon/ → Projekt-Root ist eine Ebene höher
+MARLON_PATH  = os.path.dirname(os.path.abspath(__file__))
+PROJECT_ROOT = os.path.dirname(MARLON_PATH)
+sys.path.insert(0, PROJECT_ROOT)
+sys.path.insert(0, MARLON_PATH)
+
+from thesis_topology.envs import register_all
+register_all()
+
+from marlon.simulate import train
+
+# ── Konfiguration ─────────────────────────────────────────────────────────────
+
+# Reihenfolge der Topologien für das sequenzielle Pretraining.
+# Chain zuerst (neutrale Pretraining-Topologie), dann die 4 Test-Topologien.
+TOPOLOGY_SEQUENCE = [
+    "CyberBattleChain-thesis-v0",
+    "CyberBattleFlat-thesis-v0",
+    "CyberBattleHubSpoke-thesis-v0",
+    "CyberBattleDMZ-thesis-v0",
+    "CyberBattleMicroSeg-thesis-v0",
+]
+
+DEFAULT_STEPS_PER_TOPO = 50_000   # Timesteps pro Topologie-Stufe
+DEFAULT_EPISODE_STEPS  = 2_000    # Max Schritte pro Episode
+SAVE_DIR = os.path.join(MARLON_PATH, "models")  # MARLon/models/
+
+
+def run_sequential_training(
+    topology_sequence: list[str],
+    steps_per_topology: int,
+    episode_steps: int,
+    start_from: str | None = None,
+    save_dir: str = SAVE_DIR,
+) -> str:
+    """
+    Trainiert den Attacker sequenziell über alle Topologien.
+
+    Parameters
+    ----------
+    topology_sequence : Liste der env_ids in Trainingsreihenfolge.
+    steps_per_topology : Timesteps pro Topologie-Stufe.
+    episode_steps : Max Schritte pro Episode.
+    start_from : Pfad zu einem vortrainierten Modell (optional).
+                 None = komplett neu starten.
+    save_dir : Verzeichnis für Zwischen- und Endmodelle.
+
+    Returns
+    -------
+    Pfad zum finalen Super-Modell (.zip).
+    """
+    os.makedirs(save_dir, exist_ok=True)
+    attacker_path = start_from  # None = frischer Start
+
+    print(f"\n{'='*60}")
+    print(f"  Super-Attacker Sequential Training")
+    print(f"  Topologien : {len(topology_sequence)}")
+    print(f"  Steps/Topo : {steps_per_topology:,}")
+    print(f"  Start      : {start_from or 'neu'}")
+    print(f"{'='*60}\n")
+
+    for i, env_id in enumerate(topology_sequence, start=1):
+        print(f"[{i}/{len(topology_sequence)}] Trainiere auf {env_id}")
+        if attacker_path:
+            print(f"           Lade Checkpoint: {os.path.basename(attacker_path)}")
+
+        result = train(
+            env_id=env_id,
+            attacker_algo="PPO",
+            defender_algo="None",        # Kein Defender im Pretraining
+            total_timesteps=steps_per_topology,
+            episode_steps=episode_steps,
+            save_dir=save_dir,
+            attacker_file=attacker_path, # None beim ersten Durchlauf
+            defender_file=None,
+            attacker_frozen=False,       # Weitertrainieren!
+            defender_frozen=False,
+        )
+
+        attacker_path = result["attacker"]
+        print(f"           Gespeichert: {os.path.basename(attacker_path)}\n")
+
+    # Finale Version umbenennen für klare Identifikation
+    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
+    final_path = os.path.join(save_dir, f"super_attacker_final_{timestamp}.zip")
+    os.replace(attacker_path, final_path)
+
+    print(f"{'='*60}")
+    print(f"  FERTIG — Super-Modell:")
+    print(f"  {final_path}")
+    print(f"{'='*60}\n")
+    print("Nächster Schritt — Defender Training:")
+    print("  Web-UI: Super-Modell als 'Attacker einfrieren' laden,")
+    print("          dann BA auf jeder Test-Topologie trainieren.")
+    print("  Oder: python train_defenders.py --attacker", final_path)
+
+    return final_path
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser(description="Sequenzielles Super-Attacker Training")
+    parser.add_argument("--steps",         type=int, default=DEFAULT_STEPS_PER_TOPO,
+                        help=f"Timesteps pro Topologie (default: {DEFAULT_STEPS_PER_TOPO})")
+    parser.add_argument("--episode-steps", type=int, default=DEFAULT_EPISODE_STEPS,
+                        help=f"Max Schritte pro Episode (default: {DEFAULT_EPISODE_STEPS})")
+    parser.add_argument("--start-from",    type=str, default=None,
+                        help="Pfad zu vortrainiertem Modell (default: neu starten)")
+    parser.add_argument("--only",          type=str, default=None,
+                        help="Nur eine Topologie trainieren (env_id), z.B. Chain als erster Schritt")
+    args = parser.parse_args()
+
+    topos = [args.only] if args.only else TOPOLOGY_SEQUENCE
+
+    run_sequential_training(
+        topology_sequence=topos,
+        steps_per_topology=args.steps,
+        episode_steps=args.episode_steps,
+        start_from=args.start_from,
+    )
