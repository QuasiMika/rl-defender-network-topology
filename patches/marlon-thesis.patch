+    # ── Flacher Discrete-Aktionsraum + Masking ────────────────────────────────
+    def __create_flat_action_space(self, cyber_env: CyberBattleEnv) -> gym.Space:
+        """Faltet die faktorisierten CBS-Subräume in ein einziges Discrete(N).
+
+        Jede vollständige Aktion (Typ + Parameter) bekommt einen Index. Die
+        Layout-Liste _mask_layout speichert je Subraum (key, dims, offset, size)
+        für Decode und Maskenaufbau. Node-Dimensionen werden auf node_count
+        begrenzt (wie in der MultiDiscrete-Variante)."""
+        self._mask_layout = []
+        offset = 0
+        for key, value in cyber_env.action_space.spaces.items():
+            dims = tuple(self.node_count if int(v) == self.bounds.maximum_node_count else int(v)
+                         for v in value.nvec)
+            size = int(np.prod(dims))
+            self._mask_layout.append((key, dims, offset, size))
+            offset += size
+        self._flat_action_total = offset
+        return spaces.Discrete(offset)
+
+    def _decode_flat_action(self, idx: int) -> Dict[str, Any]:
+        """Flacher Index -> nested CBS-Aktion {subspace: [params...]}."""
+        idx = int(idx)
+        for key, dims, offset, size in self._mask_layout:
+            if idx < offset + size:
+                params = np.unravel_index(idx - offset, dims)
+                return {key: np.array(params, dtype=np.int64)}
+        raise ValueError(f"Flache Aktion {idx} ausserhalb des Bereichs {self._flat_action_total}")
+
+    def _kanten_nachtragen(self, translated_action, bekannt_vorher: int) -> None:
+        """Vermerkt Kanten, die dieser Zug aufgedeckt hat.
+
+        Nur ScanHostDiscovery deckt Nachbarn auf, und das ist eine lokale
+        Aktion auf einem eigenen Knoten. Erbeutete Zugangsdaten legen bewusst
+        keine Kante an: Ein Passwort zu kennen heisst nicht, den Rechner
+        erreichen zu koennen. Genau diese Trennung ist das Kernmerkmal des
+        Topologiemodells.
+
+        Massgeblich ist, was ScanHostDiscovery auf diesem Knoten laut Topologie
+        preisgibt, NICHT welche Knoten dieser Zug neu in die Entdeckungsliste
+        gebracht hat. Der Unterschied ist entscheidend: ScanLocalCredentials
+        traegt die Knoten, zu denen der Angreifer ein Passwort erbeutet hat,
+        ebenfalls in dieselbe Liste ein. Scannt er auf einem Knoten erst die
+        Zugangsdaten und danach die Nachbarn, meldet der Nachbarscan nichts
+        Neues mehr -- die Kante entstuende dann nie. In dmz betraf das genau
+        AppServer->DomainController: der AppServer haelt die DC-Zugangsdaten,
+        und der Angreifer blieb dauerhaft bei drei von zehn Knoten stehen.
+        """
+        if "local_vulnerability" not in translated_action:
+            return
+
+        entdeckt = self.cyber_env._CyberBattleEnv__discovered_nodes
+        quelle = int(translated_action["local_vulnerability"][0])
+        vuln_index = int(translated_action["local_vulnerability"][1])
+        try:
+            vuln_id = self.cyber_env._CyberBattleEnv__index_to_local_vulnerabilityid(vuln_index)
+            quell_id = entdeckt[quelle]
+        except (IndexError, AttributeError):
+            return
+        if vuln_id != "ScanHostDiscovery":
+            return
+
+        try:
+            knoten = self.cyber_env.environment.get_node(quell_id)
+        except (KeyError, AttributeError):
+            return
+        info = knoten.vulnerabilities.get("ScanHostDiscovery")
+        nachbarn = getattr(getattr(info, "outcome", None), "nodes", None)
+        if not nachbarn:
+            return
+
+        for name in nachbarn:
+            try:
+                ziel = entdeckt.index(name)
+            except ValueError:
+                continue   # Nachbar (noch) nicht in der Entdeckungsliste
+            self._entdeckte_kanten.add((quelle, ziel))
