+    def _flatten_action_mask(self, am) -> np.ndarray:
+        """Boolescher Vektor der Laenge N: welche flachen Aktionen sind gueltig?
+        Quelle: CBS ActionMask (dict mit einem Bitfeld je Subraum)."""
+        parts = []
+        for key, dims, offset, size in self._mask_layout:
+            m = np.asarray(am[key])
+            m = m[tuple(slice(0, d) for d in dims)]   # Node-Dims auf node_count begrenzen
+            m = m.astype(bool).copy()
+
+            # Zuschnitt auf tatsaechlich aufgedeckte Kanten. Betrifft nur die
+            # Subraeume mit Quelle UND Ziel; lokale Aktionen bleiben unberuehrt,
+            # weil sie auf dem eigenen Knoten stattfinden.
+            if key in ("connect", "remote_vulnerability") and m.ndim >= 2:
+                erlaubt = np.zeros(m.shape[:2], dtype=bool)
+                for (q, z) in self._entdeckte_kanten:
+                    if q < erlaubt.shape[0] and z < erlaubt.shape[1]:
+                        erlaubt[q, z] = True
+                m &= erlaubt.reshape(erlaubt.shape + (1,) * (m.ndim - 2))
+
+            parts.append(m.reshape(-1))
+        flat = np.concatenate(parts)
+        if not flat.any():
+            # Sicherheitsnetz: MaskablePPO braucht >=1 gueltige Aktion.
+            flat[0] = True
+        return flat
