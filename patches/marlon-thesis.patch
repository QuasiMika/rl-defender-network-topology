+.stat-value.good { color: #3fb950; }
+.stat-value.warn { color: #d29922; }
+.stat-value.bad  { color: #f85149; }
+.stat-sub { font-size: 10px; color: #8b949e; margin-top: 2px; }
+
+/* ── Action log ── */
+.log-panel {
+    margin-top: 14px;
+    background: #161b22; border: 1px solid #30363d; border-radius: 6px;
+    padding: 10px 14px;
+}
+.log-panel h4 { margin: 0 0 8px; color: #89c403; font-size: 13px; text-transform: uppercase; display: inline; }
+.log-view-badge {
+    display: inline-block; margin-left: 8px; padding: 1px 7px; border-radius: 3px;
+    font-size: 11px; font-weight: bold; vertical-align: middle;
+}
+.log-view-badge.atk { background: #3d1111; color: #f85149; }
+.log-view-badge.def { background: #0d2137; color: #2dabf9; }
+.log-filters { margin: 8px 0; display: flex; gap: 8px; flex-wrap: wrap; }
+.log-filters label { font-size: 12px; cursor: pointer; user-select: none; }
+.log-filters input { cursor: pointer; }
+#logList {
+    height: 260px; overflow-y: auto;
+    font-family: monospace; font-size: 12px; line-height: 1.6;
+    background: #0d1117; border-radius: 4px; padding: 8px 10px;
+}
+.log-entry { display: flex; gap: 8px; padding: 1px 0; }
+.log-step  { color: #8b949e; min-width: 52px; }
+.log-kind  { min-width: 110px; font-weight: bold; }
+/* Attacker kinds */
+.log-kind.LATERAL_MOVE { color: #f85149; }
+.log-kind.CREDS_FOUND  { color: #d29922; }
+.log-kind.DISCOVERY    { color: #79c0ff; }
+.log-kind.REWARD       { color: #3fb950; }
