+        set_random_seed(seed)
+
+    algo_map = {"PPO": PPO, "A2C": A2C}
+
+    if attacker_algo not in algo_map:
+        raise ValueError(f"Unbekannter Algorithmus '{attacker_algo}'. Erlaubt: PPO, A2C")
+
+    if attacker_file and attacker_frozen:
+        # Eingefroren (Defender-Matrix). Bei Masking den MaskablePPO-Frozen-Agenten.
+        attacker_builder = (MaskableFrozenAgentBuilder(file_path=attacker_file)
+                            if attacker_masking else
+                            FrozenAgentBuilder(alg_type=algo_map[attacker_algo], file_path=attacker_file))
+    elif attacker_file:
+        # Laden und weitertrainieren (Super-Attacker-Curriculum).
+        attacker_builder = (MaskableLoadFileAgentBuilder(file_path=attacker_file)
+                            if attacker_masking else
+                            LoadFileBaselineAgentBuilder(alg_type=algo_map[attacker_algo], file_path=attacker_file))
+    elif attacker_masking:
